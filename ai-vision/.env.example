# ============================================
# AI Vision Service - Environment Variables
# ============================================
# Copy file nay thanh .env roi sua cho phu hop.

# === Model ===
# Duong dan den file model weights (.pth)
MODEL_PATH=weights/best_densenet121.pth

# Nguong confidence (0.0 - 1.0). Mac dinh 0.5
CONFIDENCE_THRESHOLD=0.5

# === Device ===
# auto = tu dong chon GPU neu co, khong thi CPU
# cpu  = luon dung CPU
# cuda = luon dung GPU (loi neu khong co GPU)
DEVICE=auto