# ============================================
# MedTech AI Platform - Environment Variables
# ============================================
# Copy file nay thanh .env va sua cac gia tri cho phu hop.
# File .env KHONG duoc push len git (da co trong .gitignore).

# === Database (PostgreSQL + PostGIS + pgvector) ===
DB_NAME=medtech_db
DB_USER=medtech_user
DB_PASSWORD=medtech_password_2026
DB_HOST=localhost
DB_PORT=5432

# === Django Backend (Port 8000) ===
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# === CORS (Frontend URLs cho phep truy cap API) ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === Redis (tuy chon - cho WebSocket/Cache) ===
REDIS_URL=redis://localhost:6379/0

# === AI Vision Service (Port 8001) ===
AI_VISION_URL=http://localhost:8001

# === LLM RAG Service (Port 8002) ===
LLM_RAG_URL=http://localhost:8002