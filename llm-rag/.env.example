# ============================================
# LLM RAG Service - Environment Variables
# ============================================
# Copy file nay thanh .env roi sua cho phu hop.

# === Database (pgvector) ===
DATABASE_URL=postgresql://medtech_user:medtech_password_2026@localhost:5432/medtech_db

# === Embedding Model (chay local) ===
# Model sentence-transformers de tao vector embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# === LLM Backend ===
# 'local' = dung built-in pipeline (khong can Ollama)
# 'ollama' = dung Ollama server
LLM_MODEL=local

# === Ollama (neu dung LLM_MODEL=ollama) ===
# URL cua Ollama server (co the tro sang may khac qua Tailscale)
OLLAMA_URL=http://localhost:11434
# Model name trong Ollama
OLLAMA_MODEL=qwen2.5:7b

# === LLM Parameters ===
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# === RAG Parameters ===
# Kich thuoc moi doan van ban (tokens)
CHUNK_SIZE=800
# Phan chong lap giua cac doan
CHUNK_OVERLAP=150
# So luong ket qua tra ve khi tim kiem
TOP_K=5
# Nguong do tuong dong (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.3